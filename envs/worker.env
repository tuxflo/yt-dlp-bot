APPLICATION_NAME=yt_worker

MAX_SIMULTANEOUS_DOWNLOADS=2
MAX_DOWNLOAD_THREADS=10

# Maximum number of videos queued from one playlist/series/season link.
MAX_PLAYLIST_ITEMS=100

# An unfinished download untouched for this many hours counts as orphaned (e.g. the
# worker was restarted mid-download) and is queued again when the series link is
# re-sent, instead of being skipped forever.
STALE_TASK_HOURS=6

STORAGE_PATH=/filestorage

THUMBNAIL_FRAME_SECOND=10.0
INSTAGRAM_ENCODE_TO_H264=True
FACEBOOK_ENCODE_TO_H264=True
